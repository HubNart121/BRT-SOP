# ─────────────────────────────────────────────────────────────
# BRT SOP Center — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env.local สำหรับเครื่องตัวเอง (ห้าม commit .env.local)
# ─────────────────────────────────────────────────────────────

# ─── โหมดทดลองในเครื่อง (ค่าเริ่มต้น) ───
# 1) npm run emulators     (Firebase Emulator: Firestore + Auth — ต้องมี Java 21)
# 2) npm run dev           แล้วเลือกผู้ใช้ทดลองที่หน้า Login
# โหมดนี้ถูกปิดอัตโนมัติใน production build
NEXT_PUBLIC_AUTH_MODE=dev
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# ─── ทดสอบ Firebase Login จริงในเครื่องด้วย Auth Emulator ───
# ใช้ค่าด้านล่างแทนสองบรรทัดข้างบน (npm run emulators ยังต้องรันอยู่)
# NEXT_PUBLIC_AUTH_MODE=firebase
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-brt-sop.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-brt-sop
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# BOOTSTRAP_ADMIN_EMAIL=boss@brt.test

# ─── Production (Firebase App Hosting) ───
# ตั้งค่าไว้ใน apphosting.yaml แล้ว: Firebase Web SDK config + BOOTSTRAP_ADMIN_EMAIL
# Firestore / Firebase Auth ใช้ Application Default Credentials ของ App Hosting — ไม่ต้องมีรหัสผ่านหรือ Secret
