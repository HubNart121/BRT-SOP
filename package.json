{
  "name": "brt-sop-center",
  "version": "0.1.0",
  "private": true,
  "description": "BRT SOP Center — ระบบจัดทำ ตรวจทาน อนุมัติ และเผยแพร่ SOP ของ Blue Ribbon Trading",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "emulators": "node scripts/emulators.mjs",
    "emulators:reset": "node -e \"require('fs').rmSync('.data/emulators',{recursive:true,force:true});console.log('Local emulator data removed — demo data is loaded again on the next npm run dev')\""
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
