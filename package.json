{
  "name": "brt-sop-center",
  "version": "0.1.0",
  "private": true,
  "description": "BRT SOP Center — ระบบจัดทำ ตรวจทาน อนุมัติ และเผยแพร่ SOP ของ Blue Ribbon Trading",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:schema": "node scripts/db-apply.mjs db/schema.sql",
    "db:reset-dev": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true});console.log('Local dev database removed — it is recreated with demo data on the next npm run dev')\"",
    "emulators": "firebase emulators:start --only auth --project demo-brt-sop"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
