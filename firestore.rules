rules_version = '2';

// BRT SOP Center: the browser never reads or writes Firestore directly.
// All access goes through the Next.js API (Firebase Admin SDK, which bypasses these rules),
// where authentication, roles, ownership and the approval workflow are enforced.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
